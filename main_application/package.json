{
  "name": "main_application",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:backend": "cross-env NODE_ENV=development PORT=5000 tsx server/index.ts",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "vite build --config vite.config.ts",
    "build:backend": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js",
    "build": "npm run build:frontend && npm run build:backend",
    "db:push": "drizzle-kit push --config ./db/drizzle.config.ts",
    "typecheck": "tsc --noEmit"
  },
